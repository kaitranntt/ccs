{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "..",
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["ES2022"],
    "paths": {
      "@shared/*": ["../src/shared/*"]
    },
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": [
    "./**/*.ts",
    "../src/**/__tests__/**/*.ts"
  ],
  "exclude": [
    "../node_modules",
    "../dist",
    "../ui"
  ]
}
