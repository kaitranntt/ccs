{
  "version": "1.0.0",
  "delegation": {
    "enabled": true,
    "mode": "manual",
    "defaultModel": "glm",
    "rules": {
      "keywords": {
        "always_delegate": [
          "simple refactor",
          "add unit tests",
          "fix typo",
          "fix typos",
          "add comments",
          "add documentation",
          "format code",
          "fix linting",
          "fix lint errors",
          "organize imports",
          "rename variable",
          "rename variables",
          "extract function",
          "extract method",
          "update readme",
          "add jsdoc",
          "add type hints"
        ],
        "never_delegate": [
          "architecture",
          "design pattern",
          "security",
          "authentication",
          "authorization",
          "encryption",
          "performance optimization",
          "database migration",
          "breaking change",
          "api design",
          "complex debugging",
          "system design"
        ],
        "prefer_delegate": [
          "add tests",
          "refactor",
          "cleanup",
          "simplify",
          "update docs",
          "fix formatting",
          "add validation"
        ]
      },
      "file_patterns": {
        "always_delegate": [
          "*.test.js",
          "*.test.ts",
          "*.spec.js",
          "*.spec.ts",
          "README.md",
          "CHANGELOG.md",
          "*.md"
        ],
        "never_delegate": [
          "*.config.js",
          "*.config.ts",
          "package.json",
          "tsconfig.json",
          ".env",
          ".env.*"
        ],
        "prefer_delegate": [
          "*/tests/*",
          "*/test/*",
          "*/docs/*"
        ]
      },
      "task_types": {
        "always_delegate": [
          "add_tests",
          "fix_typos",
          "format_code",
          "add_comments"
        ],
        "never_delegate": [
          "architecture_design",
          "security_implementation",
          "performance_tuning",
          "database_schema"
        ],
        "prefer_delegate": [
          "simple_refactoring",
          "documentation",
          "code_cleanup"
        ]
      }
    },
    "models": {
      "glm": {
        "displayName": "GLM-4.6",
        "profile": "glm",
        "costMultiplier": 0.1,
        "useFor": [
          "general tasks",
          "simple refactoring",
          "tests",
          "documentation"
        ]
      },
      "kimi": {
        "displayName": "Kimi",
        "profile": "kimi",
        "costMultiplier": 0.15,
        "useFor": [
          "long context",
          "large codebase analysis",
          "comprehensive documentation"
        ]
      }
    },
    "limits": {
      "maxRetries": 2,
      "timeout": 120000,
      "maxConcurrent": 1
    }
  }
}
